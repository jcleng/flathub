{
    "app-id": "app.chatboxai.chatbox",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "run.sh",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--filesystem=home"
    ],
    "modules": [
        {
            "name": "krb5",
            "buildsystem": "autotools",
            "subdir": "src",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://kerberos.org/dist/krb5/1.21/krb5-1.21.3.tar.gz",
                    "sha256": "b7a4cd5ead67fb08b980b21abd150ff7217e85ea320c9ed0c6dadd304840ad35",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13287,
                        "stable-only": true,
                        "url-template": "https://kerberos.org/dist/krb5/${version0}.${version1}/krb5-${version0}.${version1}.${version2}.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "app.chatboxai.chatbox",
            "builddir": true,
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 app.chatboxai.chatbox.desktop /app/share/applications/app.chatboxai.chatbox.desktop",
                "install -Dm644 app.chatboxai.chatbox.svg /app/share/icons/hicolor/scalable/apps/app.chatboxai.chatbox.svg",
                "mkdir -p /app/dir",
                "mkdir -p /app/bin",
                "install -Dm755 run.sh /app/bin/run.sh",
                "chmod +x Chatbox-1.9.8-x86_64.AppImage",
                "./Chatbox-1.9.8-x86_64.AppImage --appimage-extract",
                "cp -ar squashfs-root/* /app/dir/",
                "rm -rf ./squashfs-root"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "app.chatboxai.chatbox.desktop"
                },
                {
                    "type": "file",
                    "path": "app.chatboxai.chatbox.svg"
                },
                {
                    "type": "file",
                    "path": "Chatbox-1.9.8-x86_64.AppImage"
                },
                {
                    "type": "file",
                    "path": "run.sh"
                }
            ]
        }
    ]
}
