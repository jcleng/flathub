{
    "app-id": "cn.lpkt.serverbox",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "run.sh",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--filesystem=home"
    ],
    "modules": [
        {
            "name": "cn.lpkt.serverbox",
            "builddir": true,
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 cn.lpkt.serverbox.desktop /app/share/applications/cn.lpkt.serverbox.desktop",
                "install -Dm644 cn.lpkt.serverbox.svg /app/share/icons/hicolor/scalable/apps/cn.lpkt.serverbox.svg",
                "mkdir -p /app/dir",
                "mkdir -p /app/bin",
                "install -Dm755 run.sh /app/bin/run.sh",
                "chmod +x ServerBox_1124_amd64.AppImage",
                "./ServerBox_1124_amd64.AppImage --appimage-extract",
                "cp -ar squashfs-root/* /app/dir/",
                "rm -rf ./squashfs-root"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "cn.lpkt.serverbox.desktop"
                },
                {
                    "type": "file",
                    "path": "cn.lpkt.serverbox.svg"
                },
                {
                    "type": "file",
                    "path": "ServerBox_1124_amd64.AppImage"
                },
                {
                    "type": "file",
                    "path": "run.sh"
                }
            ]
        }
    ]
}
